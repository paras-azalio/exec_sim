--- a/src/main/java/cliautomation/exec/LocalCommandExecutor.java
+++ b/src/main/java/cliautomation/exec/LocalCommandExecutor.java
@@ -31,8 +31,11 @@ class LocalCommandExecutor {
 
         // scp/sftp write password prompts to /dev/tty — bypassing stdout/stderr entirely.
         // Use JSch SFTP directly so password auth is handled in pure Java.
-        if (hasExpect && !isWindows() && looksLikeScpCommand(command)) {
-            return executeScpViaJsch(command, timeoutSec, expectReplyDefs);
+        // On Windows this is normally skipped, but an explicit POSIX local shell
+        // (-Dclicr.local.shell) means the caller wants POSIX semantics throughout.
+        if (hasExpect && looksLikeScpCommand(command)
